---
import BaseLayout from './BaseLayout.astro';
import AuthorContact from '../components/AuthorContact.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  author?: string;
  category?: string;
  tags?: string[];
  keywords?: string[];
  faqs?: FaqItem[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author = 'Bank วุฒิพิพัฒน์',
  category,
  tags = [],
  keywords = [],
  faqs = [],
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: author,
    url: new URL('/about', Astro.site).toString(),
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && { image: new URL(heroImage, Astro.site).toString() }),
  publisher: {
    '@type': 'Person',
    name: 'Bank วุฒิพิพัฒน์',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'บทความ', item: new URL('/blog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

// FAQ Schema (if faqs provided)
const faqLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

const dateFormat = new Intl.DateTimeFormat('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogType="article"
  ogImage={heroImage}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <article class="mx-auto max-w-[800px] px-5 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-warm-gray" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1">
        <li><a href="/" class="hover:text-navy">หน้าแรก</a></li>
        <li>/</li>
        <li><a href="/blog" class="hover:text-navy">บทความ</a></li>
        <li>/</li>
        <li class="text-charcoal">{title}</li>
      </ol>
    </nav>

    {heroImage && (
      <img
        src={heroImage}
        alt={title}
        class="mb-8 w-full rounded-xl object-cover"
        loading="eager"
      />
    )}

    <header class="mb-8">
      {category && (
        <span class="mb-3 inline-block rounded bg-navy-light/10 px-3 py-1 text-xs font-medium text-navy-light">
          {category}
        </span>
      )}
      <h1 class="mb-4 font-heading text-3xl font-bold leading-tight text-navy md:text-4xl">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-warm-gray">
        <span>โดย {author}</span>
        <time datetime={pubDate.toISOString()}>{dateFormat.format(pubDate)}</time>
        {updatedDate && (
          <span>(อัปเดต: <time datetime={updatedDate.toISOString()}>{dateFormat.format(updatedDate)}</time>)</span>
        )}
      </div>
    </header>

    <!-- Table of Contents (auto-generated by JS) -->
    <nav id="toc" class="mb-10 hidden rounded-xl border border-gray-border bg-cream/50 p-5">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-navy">สารบัญ</h2>
      <ol id="toc-list" class="space-y-1.5 text-sm text-charcoal"></ol>
    </nav>

    <!-- Article Content -->
    <div id="article-content" class="
      prose prose-lg max-w-none
      prose-headings:font-heading prose-headings:text-navy
      prose-h2:mt-10 prose-h2:border-l-4 prose-h2:border-gold prose-h2:pl-4
      prose-h3:mt-6
      prose-a:text-navy-light prose-a:decoration-gold prose-a:underline-offset-2
      hover:prose-a:text-gold-dark
      prose-table:overflow-x-auto prose-table:block prose-table:w-full
      prose-th:bg-navy prose-th:text-white prose-th:px-3 prose-th:py-2 prose-th:text-left prose-th:text-sm prose-th:font-medium
      prose-td:border prose-td:border-gray-border prose-td:px-3 prose-td:py-2 prose-td:text-sm
      prose-tr:even:bg-cream/50
      prose-img:rounded-xl
    ">
      <slot />
    </div>

    <!-- FAQ Section (if provided via frontmatter) -->
    {faqs.length > 0 && (
      <section class="mt-12 border-t border-gray-border pt-8">
        <h2 class="mb-6 font-heading text-2xl font-semibold text-navy">คำถามที่พบบ่อย</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-gray-border p-4 transition open:shadow-card">
              <summary class="flex cursor-pointer items-center justify-between font-semibold text-navy">
                <span>{faq.question}</span>
                <svg class="h-5 w-5 shrink-0 text-warm-gray transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 leading-relaxed text-charcoal">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-8 border-t border-gray-border pt-6">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-navy/5 px-3 py-1 text-xs text-navy">{tag}</span>
          ))}
        </div>
      </div>
    )}

    <!-- Author Contact CTA -->
    <div class="mt-10">
      <AuthorContact />
    </div>
  </article>

  <!-- Table of Contents Script -->
  <script>
    function buildToc() {
      const content = document.getElementById('article-content');
      const tocNav = document.getElementById('toc');
      const tocList = document.getElementById('toc-list');
      if (!content || !tocNav || !tocList) return;

      const headings = content.querySelectorAll('h2, h3');
      if (headings.length < 3) return; // Only show ToC if 3+ headings

      const items: string[] = [];
      headings.forEach((heading, i) => {
        const id = heading.id || `section-${i}`;
        heading.id = id;
        const level = heading.tagName === 'H3' ? 'ml-4' : '';
        items.push(`<li class="${level}"><a href="#${id}" class="text-navy-light hover:text-gold-dark transition">${heading.textContent}</a></li>`);
      });

      tocList.innerHTML = items.join('');
      tocNav.classList.remove('hidden');
    }

    buildToc();
  </script>
</BaseLayout>
