---
import BaseLayout from './BaseLayout.astro';
import AuthorContact from '../components/AuthorContact.astro';
import AuthorSidebar from '../components/AuthorSidebar.astro';
import { getCollection } from 'astro:content';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  author?: string;
  category?: string;
  tags?: string[];
  keywords?: string[];
  faqs?: FaqItem[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author = 'พิสิทธิ์ วุฒิพิพัฒน์ (Bank)',
  category,
  tags = [],
  keywords = [],
  faqs = [],
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: author,
    url: new URL('/about', Astro.site).toString(),
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && { image: new URL(heroImage, Astro.site).toString() }),
  publisher: {
    '@type': 'Person',
    name: 'พิสิทธิ์ วุฒิพิพัฒน์',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'บทความ', item: new URL('/blog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const faqLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

const dateFormat = new Intl.DateTimeFormat('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });

// Related articles — same category, exclude current
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const currentSlug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const related = allPosts
  .filter((p) => p.data.category === category && p.id !== currentSlug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogType="article"
  ogImage={heroImage}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <!-- TWO-COLUMN LAYOUT: article (70%) + sidebar (30%) -->
  <div class="mx-auto flex max-w-[1100px] gap-8 px-5 py-10">

    <!-- MAIN ARTICLE COLUMN -->
    <article class="min-w-0 flex-1">

      <!-- Breadcrumb -->
      <nav class="mb-5 text-sm text-warm-gray" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1">
          <li><a href="/" class="hover:text-navy">หน้าแรก</a></li>
          <li class="text-gray-border">/</li>
          <li><a href="/blog" class="hover:text-navy">บทความ</a></li>
          <li class="text-gray-border">/</li>
          <li class="text-charcoal line-clamp-1">{title}</li>
        </ol>
      </nav>

      <!-- Hero Image -->
      {heroImage && (
        <figure class="mb-8">
          <img
            src={heroImage}
            alt={title}
            class="w-full rounded-2xl object-cover shadow-card"
            loading="eager"
          />
        </figure>
      )}

      <!-- Header -->
      <header class="mb-6">
        {category && (
          <span class="mb-3 inline-block rounded-full bg-gradient-to-r from-navy to-navy-light px-4 py-1 text-xs font-semibold text-white">
            {category}
          </span>
        )}
        <h1 class="mb-4 border-b-[3px] border-gold pb-3 font-heading text-[1.75rem] font-extrabold leading-tight text-navy">{title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-sm text-warm-gray">
          <div class="flex items-center gap-2">
            <div class="h-8 w-8 rounded-full border-2 border-gold bg-navy-light"></div>
            <span class="font-medium text-charcoal">{author}</span>
          </div>
          <span class="text-gray-border">|</span>
          <time datetime={pubDate.toISOString()}>{dateFormat.format(pubDate)}</time>
          {updatedDate && (
            <span class="rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
              อัปเดต {dateFormat.format(updatedDate)}
            </span>
          )}
        </div>
      </header>

      <!-- Section Nav Pills (auto-generated by JS) -->
      <nav id="section-pills" class="mb-8 hidden">
        <div id="pills-container" class="flex flex-wrap gap-2"></div>
      </nav>

      <!-- Article Content with Visual Styling -->
      <div id="article-content" class="article-body">
        <slot />
      </div>

      <!-- FAQ Section -->
      {faqs.length > 0 && (
        <section class="mt-12 rounded-2xl bg-cream p-6 md:p-8">
          <h2 class="mb-6 font-heading text-2xl font-semibold text-navy">คำถามที่พบบ่อย</h2>
          <div class="space-y-3">
            {faqs.map((faq) => (
              <details class="group rounded-xl border border-gray-border bg-white p-4 transition open:shadow-card">
                <summary class="flex cursor-pointer items-center justify-between font-semibold text-navy">
                  <span>{faq.question}</span>
                  <svg class="h-5 w-5 shrink-0 text-warm-gray transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <p class="mt-3 leading-relaxed text-charcoal">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Tags as Colored Pills -->
      {tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-gradient-to-r from-navy/10 to-navy-light/10 px-4 py-1.5 text-xs font-medium text-navy shadow-sm">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Author Box (full) -->
      <div class="mt-10 rounded-2xl border border-gray-border bg-cream/50 p-6 md:p-8">
        <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-start">
          <div class="h-20 w-20 shrink-0 rounded-full border-[3px] border-gold bg-navy-light shadow-card"></div>
          <div>
            <h3 class="text-lg font-semibold text-navy">พิสิทธิ์ วุฒิพิพัฒน์ (Bank)</h3>
            <p class="mb-2 text-sm text-warm-gray">ที่ปรึกษาการเงินและการประกันภัย</p>
            <div class="mb-3 flex flex-wrap gap-1.5">
              <span class="rounded-full bg-gold/15 px-2.5 py-0.5 text-[10px] font-bold text-gold-dark">MDRT</span>
              <span class="rounded-full bg-navy/10 px-2.5 py-0.5 text-[10px] font-semibold text-navy">IC Licensed</span>
            </div>
            <p class="text-sm leading-relaxed text-charcoal">
              ผมเชื่อว่าทุกคนควรเข้าใจ Unit Link ก่อนตัดสินใจ — ข้อมูลทั้งข้อดีและข้อเสีย อย่างตรงไปตรงมา
            </p>
          </div>
        </div>
      </div>

      <!-- Related Articles -->
      {related.length > 0 && (
        <section class="mt-10">
          <h2 class="mb-6 font-heading text-2xl font-semibold text-navy">บทความที่เกี่ยวข้อง</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {related.map((post) => (
              <a href={`/blog/${post.id}`} class="group overflow-hidden rounded-2xl border border-gray-border bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
                <div class="h-2 bg-gradient-to-r from-navy to-gold"></div>
                <div class="p-4">
                  <span class="mb-2 inline-block rounded-full bg-navy-light/10 px-2.5 py-0.5 text-[10px] font-medium text-navy-light">
                    {post.data.category}
                  </span>
                  <h3 class="mb-2 text-sm font-semibold leading-snug text-charcoal group-hover:text-navy line-clamp-2">
                    {post.data.title}
                  </h3>
                  <time class="text-xs text-warm-gray" datetime={post.data.pubDate.toISOString()}>
                    {dateFormat.format(post.data.pubDate)}
                  </time>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Big CTA -->
      <div class="mt-10 rounded-2xl bg-gradient-to-br from-navy to-navy-light p-8 text-center text-white md:p-10">
        <h3 class="mb-3 font-heading text-2xl font-bold">ปรึกษาเรื่อง Unitlink ฟรี</h3>
        <p class="mb-6 text-sm text-white/70">ไม่มีค่าใช้จ่าย ไม่มีข้อผูกมัด — ตอบทุกคำถามของคุณ</p>
        <a
          href="https://line.me/R/ti/p/@unitlinkbybank"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl bg-gold px-8 py-3.5 text-base font-bold text-navy shadow-lg transition hover:bg-gold-dark hover:shadow-xl"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          ปรึกษาผ่าน LINE
        </a>
      </div>

      <!-- Mobile: Author Contact (only on mobile, sidebar handles desktop) -->
      <div class="mt-8 lg:hidden">
        <AuthorContact />
      </div>
    </article>

    <!-- STICKY SIDEBAR (desktop only) -->
    <AuthorSidebar />
  </div>

  <!-- Section Pills + ToC Script -->
  <script>
    function buildSectionNav() {
      const content = document.getElementById('article-content');
      const pillsNav = document.getElementById('section-pills');
      const pillsContainer = document.getElementById('pills-container');
      if (!content || !pillsNav || !pillsContainer) return;

      const h2s = content.querySelectorAll('h2');
      if (h2s.length < 2) return;

      let counter = 0;
      const pills: string[] = [];

      h2s.forEach((h2, i) => {
        counter++;
        const id = `section-${counter}`;
        h2.id = id;

        // Add numbered circle before h2 text
        const num = document.createElement('span');
        num.className = 'section-number';
        num.textContent = String(counter);
        h2.prepend(num);

        pills.push(
          `<a href="#${id}" class="inline-flex items-center gap-1.5 rounded-full border border-gold/30 bg-gold/5 px-3.5 py-1.5 text-xs font-medium text-navy transition hover:bg-gold hover:text-navy">`
          + `<span class="flex h-5 w-5 items-center justify-center rounded-full bg-gold text-[10px] font-bold text-navy">${counter}</span>`
          + `${(h2.textContent || '').replace(String(counter), '').trim().substring(0, 30)}`
          + `</a>`
        );
      });

      // Also number h3s
      const h3s = content.querySelectorAll('h3');
      h3s.forEach((h3, i) => {
        const id = `sub-${i}`;
        h3.id = id;
      });

      pillsContainer.innerHTML = pills.join('');
      pillsNav.classList.remove('hidden');
    }

    buildSectionNav();

    // Wrap tables in scroll containers for mobile
    document.querySelectorAll('.article-body table').forEach((table) => {
      if (table.parentElement?.classList.contains('table-scroll-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'table-scroll-wrapper';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  </script>
</BaseLayout>
