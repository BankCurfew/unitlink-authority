        </blockquote>
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-navy-light text-sm font-bold text-white">น</div>
          <div>
            <p class="text-sm font-semibold text-navy">คุณนภา</p>
            <p class="text-xs text-warm-gray">ผู้ถือกรมธรรม์ Unit Linked · 5 ปี</p>
          </div>
        </div>
      </div>

      <!-- Testimonial 3 -->
      <div class="rounded-xl border border-gray-border bg-white p-6 shadow-card transition hover:shadow-card-hover">
        <div class="mb-4 flex items-center gap-1 text-gold">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M10 1l2.39 6.09H19l-5.3 4.09 2 6.41L10 13.5l-5.7 4.09 2-6.41L1 7.09h6.61z"/></svg>
          <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M10 1l2.39 6.09H19l-5.3 4.09 2 6.41L10 13.5l-5.7 4.09 2-6.41L1 7.09h6.61z"/></svg>
