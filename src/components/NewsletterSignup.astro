---
// Newsletter Signup — UI UX Pro Max: "Newsletter/Content First" pattern
// "Single field form, show 'Join X,000 readers'"
interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
---

{variant === 'full' ? (
  <section class="bg-navy px-5 py-14">
    <div class="mx-auto max-w-[600px] text-center">
      <h2 class="mb-2 font-heading text-2xl font-semibold text-white md:text-3xl">
        ติดตามบทความใหม่
      </h2>
      <p class="mb-6 text-sm text-white/60">
        รับความรู้เรื่อง Unit Link ค่าธรรมเนียม และการวางแผนการเงิน ส่งตรงถึงอีเมล
      </p>
      <form class="flex flex-col gap-3 sm:flex-row sm:gap-2" data-newsletter>
        <input
          type="email"
          placeholder="อีเมลของคุณ"
          required
          class="flex-1 rounded-lg border border-white/20 bg-white/10 px-4 py-3 text-sm text-white placeholder-white/40 backdrop-blur-sm focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold/30"
        />
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-gold px-6 py-3 text-sm font-semibold text-navy transition hover:bg-gold-dark"
        >
          สมัครรับข่าวสาร
        </button>
      </form>
      <p class="mt-3 text-xs text-white/40">ไม่มีสแปม ยกเลิกได้ตลอดเวลา</p>
    </div>
  </section>
) : (
  <div class="rounded-xl border border-gray-border bg-cream/50 p-4">
    <p class="mb-2 text-sm font-semibold text-navy">รับบทความใหม่ทางอีเมล</p>
    <form class="flex gap-2" data-newsletter>
      <input
        type="email"
        placeholder="อีเมล"
        required
        class="min-w-0 flex-1 rounded-lg border border-gray-border bg-white px-3 py-2 text-sm text-charcoal placeholder-warm-gray focus:border-gold focus:outline-none"
      />
      <button
        type="submit"
        class="shrink-0 rounded-lg bg-gold px-3 py-2 text-xs font-semibold text-navy transition hover:bg-gold-dark"
      >
        สมัคร
      </button>
    </form>
  </div>
)}
