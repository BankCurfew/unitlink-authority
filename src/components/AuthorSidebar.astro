---
// Sticky author sidebar — desktop only, right side during article scroll
---

<aside class="hidden lg:block">
  <div class="sticky top-[80px] w-[260px] rounded-xl border border-gray-border bg-white p-5 shadow-card">
    <!-- Avatar -->
    <div class="mb-3 flex items-center gap-3">
      <img src="/images/bank-portrait.png" alt="Bank วุฒิพิพัฒน์" class="h-12 w-12 shrink-0 rounded-full border-2 border-gold object-cover" />
      <div>
        <p class="text-sm font-semibold text-navy">Bank วุฒิพิพัฒน์</p>
        <p class="text-xs text-warm-gray">ที่ปรึกษาการเงิน</p>
      </div>
    </div>

    <!-- Credentials -->
    <div class="mb-4 flex flex-wrap gap-1.5">
      <span class="rounded-full bg-gold/15 px-2 py-0.5 text-[10px] font-semibold text-gold-dark">MDRT</span>
      <span class="rounded-full bg-navy/10 px-2 py-0.5 text-[10px] font-medium text-navy">IC Licensed</span>
    </div>

    <!-- CTA -->
    <a
      href="https://line.me/R/ti/p/@unitlinkbybank"
      target="_blank"
      rel="noopener"
      class="mb-2 flex w-full items-center justify-center gap-2 rounded-lg bg-[#06C755] py-2.5 text-sm font-semibold text-white transition hover:bg-[#05b04c]"
    >
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      ปรึกษาผ่าน LINE
    </a>
    <a
      href="/about"
      class="flex w-full items-center justify-center rounded-lg border border-navy/20 py-2 text-sm font-medium text-navy transition hover:bg-navy hover:text-white"
    >
      เกี่ยวกับผม
    </a>
  </div>
</aside>
