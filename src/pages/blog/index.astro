---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="บทความ"
  description="บทความความรู้เรื่อง Unitlink ประกันควบการลงทุน — ครบทุกหัวข้อ เข้าใจง่าย โดย Bank วุฒิพิพัฒน์"
  keywords={['unitlink บทความ', 'ความรู้ unitlink', 'ประกันควบการลงทุน']}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="mb-2 text-3xl font-bold text-gray-900">บทความ</h1>
    <p class="mb-10 text-gray-600">ความรู้เรื่อง Unitlink และการวางแผนการเงิน</p>

    {posts.length === 0 ? (
      <p class="text-gray-500">ยังไม่มีบทความ — กำลังเตรียมเนื้อหาอยู่</p>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group block rounded-xl border border-gray-100 p-6 transition hover:shadow-md">
            <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
              <div>
                <span class="mb-1 inline-block rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-700">
                  {post.data.category}
                </span>
                <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600">{post.data.title}</h2>
                <p class="mt-1 text-sm text-gray-600">{post.data.description}</p>
              </div>
              <time class="shrink-0 text-sm text-gray-400" datetime={post.data.pubDate.toISOString()}>
                {dateFormat.format(post.data.pubDate)}
              </time>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
