---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="บทความ"
  description="บทความความรู้เรื่อง Unitlink ประกันควบการลงทุน — ครบทุกหัวข้อ เข้าใจง่าย โดย Bank วุฒิพิพัฒน์"
  keywords={['unitlink บทความ', 'ความรู้ unitlink', 'ประกันควบการลงทุน']}
>
  <section class="mx-auto max-w-[900px] px-5 py-12">
    <h1 class="mb-2 border-b-[3px] border-gold pb-3 text-[1.75rem] font-extrabold text-navy">บทความ</h1>
    <p class="mb-10 text-warm-gray">ความรู้เรื่อง Unitlink และการวางแผนการเงิน</p>

    {posts.length === 0 ? (
      <p class="text-warm-gray">ยังไม่มีบทความ — กำลังเตรียมเนื้อหาอยู่</p>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group flex flex-col overflow-hidden rounded-xl border border-gray-border bg-white shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover sm:flex-row">
            {post.data.heroImage && (
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="aspect-video w-full object-cover sm:aspect-square sm:w-48 sm:shrink-0"
                loading="lazy"
              />
            )}
            <div class="flex flex-1 flex-col justify-center p-5">
              <span class="mb-2 inline-block w-fit rounded-full bg-navy-light/10 px-2.5 py-0.5 text-xs font-medium text-navy-light">
                {post.data.category}
              </span>
              <h2 class="mb-1 text-lg font-bold text-navy group-hover:text-gold-dark">{post.data.title}</h2>
              <p class="mb-2 text-sm text-warm-gray line-clamp-2">{post.data.description}</p>
              <time class="text-xs text-warm-gray" datetime={post.data.pubDate.toISOString()}>
                {dateFormat.format(post.data.pubDate)}
              </time>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
