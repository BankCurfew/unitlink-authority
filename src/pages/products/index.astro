---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="ผลิตภัณฑ์ Unitlink"
  description="เปรียบเทียบผลิตภัณฑ์ Unit Linked ทุกแบบ — UB, Pay Life, HH, CI Plus, HB Extra โดย Bank วุฒิพิพัฒน์"
  keywords={['unitlink ผลิตภัณฑ์', 'เปรียบเทียบ unitlink', 'AIA unit linked']}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="mb-2 text-3xl font-bold text-gray-900">ผลิตภัณฑ์ Unitlink</h1>
    <p class="mb-10 text-gray-600">เปรียบเทียบแบบประกัน Unit Linked ทุกแบบ</p>

    {products.length === 0 ? (
      <p class="text-gray-500">กำลังเตรียมข้อมูลผลิตภัณฑ์</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {products.map((product) => (
          <a href={`/products/${product.id}`} class="group rounded-xl border border-gray-100 p-6 transition hover:shadow-md">
            <span class="mb-2 inline-block rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-700">
              {product.data.category}
            </span>
            <h2 class="mb-2 text-xl font-semibold text-gray-900 group-hover:text-blue-600">
              {product.data.shortName}
            </h2>
            <p class="mb-4 text-sm text-gray-600">{product.data.description}</p>
            {product.data.features.length > 0 && (
              <ul class="space-y-1">
                {product.data.features.slice(0, 3).map((f) => (
                  <li class="flex items-start gap-1.5 text-xs text-gray-500">
                    <span class="mt-0.5 text-green-500">&#10003;</span>
                    {f}
                  </li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
