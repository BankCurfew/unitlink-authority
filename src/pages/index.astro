---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSection from '../components/ProfileSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const products = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bank วุฒิพิพัฒน์',
  jobTitle: 'ที่ปรึกษาการเงินและการประกันภัย',
  url: new URL('/about', Astro.site).toString(),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Unitlink by Bank',
  url: Astro.site?.toString(),
  description: 'เข้าใจ Unit Link ทุกมิติ — ค่าธรรมเนียม ผลตอบแทน ความคุ้มครอง',
  author: { '@type': 'Person', name: 'Bank วุฒิพิพัฒน์' },
};

const dateFormat = new Intl.DateTimeFormat('th-TH', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Home"
  description="Unitlink by Bank — เข้าใจ Unit Link ทุกมิติ ค่าธรรมเนียม ผลตอบแทน ความคุ้มครอง โดย Bank วุฒิพิพัฒน์ ที่ปรึกษาการเงิน"
  keywords={['unitlink', 'unit linked', 'ประกันควบการลงทุน', 'ยูนิตลิงค์', 'Bank วุฒิพิพัฒน์']}
  jsonLd={websiteLd}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </Fragment>

  <!-- Hero — enhanced with visual + stats -->
  <section class="relative overflow-hidden bg-gradient-to-br from-navy to-navy-light px-5 py-20 text-white md:py-28">
    <!-- Decorative circles -->
    <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-gold/5 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-10 -left-10 h-60 w-60 rounded-full bg-gold/5 blur-3xl"></div>

    <div class="mx-auto max-w-[800px] text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium text-gold backdrop-blur-sm">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        MDRT Member · IC Licensed
      </div>
      <h1 class="mb-6 font-heading text-4xl font-bold leading-tight md:text-5xl">
        เข้าใจ <span class="text-gold">Unit Link</span><br />ทุกมิติ
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-white/80">
        ค่าธรรมเนียม ผลตอบแทน ความคุ้มครอง — ครบจบในที่เดียว<br />
        โดย Bank วุฒิพิพัฒน์ ที่ปรึกษาการเงินและการประกันภัย
      </p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/blog" class="rounded-lg bg-gold px-6 py-3 font-semibold text-navy transition hover:bg-gold-dark">
          อ่านบทความ
        </a>
        <a href="/products" class="rounded-lg border-2 border-white px-6 py-3 font-semibold text-white transition hover:bg-white hover:text-navy">
          ดูผลิตภัณฑ์
        </a>
        <a href="/tools/fee-calculator" class="text-sm font-medium text-white/60 underline underline-offset-4 hover:text-gold">
          คำนวณค่าธรรมเนียม →
        </a>
      </div>
    </div>
  </section>

  <!-- Why Unitlink -->
  <section class="reveal mx-auto max-w-[1200px] px-5 py-16">
    <h2 class="mb-10 text-center font-heading text-2xl font-semibold text-navy md:text-3xl">ทำไมต้อง Unit Link?</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <div class="rounded-xl border border-gray-border p-6 text-center shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-navy/10">
          <svg class="h-7 w-7 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-navy">ลงทุน + ประกัน ในกรมธรรม์เดียว</h3>
        <p class="text-sm text-warm-gray">รวมความคุ้มครองชีวิตและการลงทุนไว้ด้วยกัน ยืดหยุ่นสูง</p>
      </div>
      <div class="rounded-xl border border-gray-border p-6 text-center shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-navy/10">
          <svg class="h-7 w-7 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-navy">เลือกกองทุนได้ตามเป้าหมาย</h3>
        <p class="text-sm text-warm-gray">สับเปลี่ยนกองทุนได้ตามสภาวะตลาด ปรับพอร์ตได้ตลอด</p>
      </div>
      <div class="rounded-xl border border-gray-border p-6 text-center shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-navy/10">
          <svg class="h-7 w-7 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-navy">ลดหย่อนภาษีได้</h3>
        <p class="text-sm text-warm-gray">เบี้ยประกันชีวิตลดหย่อนภาษีได้สูงสุดตามเกณฑ์สรรพากร</p>
      </div>
    </div>
  </section>

  <!-- Stats Counter — verifiable data only -->
  <section class="bg-navy px-5 py-14">
    <div class="mx-auto grid max-w-[900px] grid-cols-2 gap-8 text-center md:grid-cols-3">
      <div class="reveal">
        <p class="font-data text-3xl font-medium text-gold md:text-4xl" data-counter={products.length}>{products.length}</p>
        <p class="mt-1 text-sm text-white/60">ผลิตภัณฑ์ที่วิเคราะห์</p>
      </div>
      <div class="reveal">
        <p class="font-data text-3xl font-medium text-gold md:text-4xl" data-counter={posts.length}>{posts.length}</p>
        <p class="mt-1 text-sm text-white/60">บทความความรู้</p>
      </div>
      <div class="reveal">
        <p class="font-data text-3xl font-medium text-gold md:text-4xl" data-counter="4">4</p>
        <p class="mt-1 text-sm text-white/60">ประเภทค่าธรรมเนียมที่เปรียบเทียบ</p>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  {posts.length > 0 && (
    <section class="bg-cream px-5 py-16">
      <div class="mx-auto max-w-[1200px]">
        <h2 class="mb-10 text-center font-heading text-2xl font-semibold text-navy md:text-3xl">บทความล่าสุด</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group overflow-hidden rounded-xl border border-gray-border bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
              {post.data.heroImage && (
                <div class="overflow-hidden">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="aspect-[4/3] w-full object-cover object-top transition group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-5">
                <span class="mb-2 inline-block rounded-full bg-navy-light/10 px-2.5 py-0.5 text-xs font-medium text-navy-light">
                  {post.data.category}
                </span>
                <h3 class="mb-2 font-heading text-base font-semibold text-charcoal group-hover:text-navy line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="mb-3 text-sm text-warm-gray line-clamp-2">{post.data.description}</p>
                <time class="text-xs text-warm-gray" datetime={post.data.pubDate.toISOString()}>
                  {dateFormat.format(post.data.pubDate)}
                </time>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/blog" class="text-sm font-medium text-navy hover:text-gold-dark">&rarr; ดูบทความทั้งหมด</a>
        </div>
      </div>
    </section>
  )}

  <!-- Products -->
  {products.length > 0 && (
    <section class="mx-auto max-w-[1200px] px-5 py-16">
      <h2 class="mb-10 text-center font-heading text-2xl font-semibold text-navy md:text-3xl">ผลิตภัณฑ์ Unit Link</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <a href={`/products/${product.id}`} class="group rounded-xl border border-gray-border p-6 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-hover">
            <span class="mb-2 inline-block rounded bg-success/10 px-2 py-0.5 text-xs font-medium text-success">
              {product.data.category}
            </span>
            <h3 class="mb-2 font-heading text-lg font-semibold text-charcoal group-hover:text-navy">
              {product.data.shortName}
            </h3>
            <p class="text-sm text-warm-gray line-clamp-2">{product.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- Testimonials -->
  <TestimonialSection />

  <!-- Profile -->
  <ProfileSection />

  <!-- Newsletter -->
  <NewsletterSignup />

  <!-- CTA -->
  <section class="bg-cream px-5 py-16 text-center">
    <div class="mx-auto max-w-[600px]">
      <h2 class="mb-4 font-heading text-2xl font-bold md:text-3xl">พร้อมวางแผนการเงินหรือยัง?</h2>
      <p class="mb-8 text-white/60">ปรึกษาฟรี ไม่มีค่าใช้จ่าย — Bank วุฒิพิพัฒน์ ที่ปรึกษาการเงิน</p>
      <a href="/about" class="inline-block rounded-lg bg-gold px-8 py-3 font-semibold text-navy transition hover:bg-gold-dark">
        ติดต่อปรึกษา
      </a>
    </div>
  </section>

  <!-- Animations: scroll reveal + counter -->
  <style>
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* Stagger children */
    .reveal:nth-child(2) { transition-delay: 0.1s; }
    .reveal:nth-child(3) { transition-delay: 0.2s; }
    .reveal:nth-child(4) { transition-delay: 0.3s; }
  </style>

  <script>
    // Scroll reveal
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    // Counter animation
    const counterObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.counter || '0');
          let current = 0;
          const increment = Math.max(1, Math.floor(target / 40));
          const timer = setInterval(() => {
            current += increment;
            if (current >= target) {
              current = target;
              clearInterval(timer);
            }
            el.textContent = current.toLocaleString('th-TH');
          }, 30);
          counterObserver.unobserve(el);
        });
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll('[data-counter]').forEach((el) => counterObserver.observe(el));
  </script>
</BaseLayout>
